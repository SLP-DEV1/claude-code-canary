{
  "name": "claude-code-canary",
  "version": "1.0.0",
  "description": "Deterministic regression testing, release bisection and plugin compatibility matrices for Claude Code",
  "type": "module",
  "bin": {
    "claude-canary": "./dist/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "claude-code",
    "anthropic",
    "regression-testing",
    "compatibility-testing",
    "version-bisect",
    "github-actions",
    "plugins",
    "mcp",
    "agent-evals",
    "ai-coding",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SLP-DEV1/claude-code-canary.git"
  },
  "homepage": "https://github.com/SLP-DEV1/claude-code-canary#readme",
  "bugs": {
    "url": "https://github.com/SLP-DEV1/claude-code-canary/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "commander": "^14.0.0",
    "minimatch": "^10.0.3",
    "openpgp": "^6.3.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@openpgp/web-stream-tools": "^0.3.1",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
